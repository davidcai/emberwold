{
  "name": "emberwold",
  "version": "0.0.0",
  "private": true,
  "description": "Emberwold T0 spike - private hobby project",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check \"{packages,tools}/**/*.{ts,tsx}\" \"e2e/**/*.ts\" playwright.config.ts",
    "test": "vitest run",
    "boundaries": "depcruise packages tools --config .dependency-cruiser.cjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm boundaries && pnpm traces:check",
    "content:build": "node tools/content-compiler/src/main.ts",
    "content:check": "pnpm content:build && git diff --exit-code -- packages/content",
    "trace:verify": "tsx tools/golden-traces/src/verify.ts",
    "trace:record": "tsx tools/golden-traces/src/record.ts",
    "play": "tsx tools/play-cli/src/cli.ts",
    "fuzz": "tsx tools/play-cli/src/fuzz.ts",
    "trace:scenario": "tsx tools/golden-traces/src/record-scenario.ts",
    "dev": "pnpm --filter @emberwold/client dev",
    "build": "pnpm --filter @emberwold/client build",
    "test:e2e": "playwright test",
    "preview": "pnpm --filter @emberwold/client preview",
    "traces:check": "tsx tools/golden-traces/src/verify.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
