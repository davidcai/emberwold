{
  "name": "emberwold",
  "version": "0.0.0",
  "private": true,
  "description": "Emberwold T0 spike - private hobby project",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check \"{packages,tools}/**/*.ts\"",
    "test": "vitest run",
    "boundaries": "depcruise packages tools --config .dependency-cruiser.cjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm boundaries"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
